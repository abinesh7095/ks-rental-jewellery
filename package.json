{
  "name": "ks-rental-jewellery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "cross-env NODE_ENV=production node server/index.js",
    "dev": "concurrently -n server,client -c blue,green \"node server/index.js\" \"vite\"",
    "client": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "electron:dev": "concurrently -k -n client,electron -c green,blue \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "sql.js": "^1.9.0",
    "concurrently": "^8.2.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^5.0.10",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "wait-on": "^7.2.0",
    "cross-env": "^7.0.3"
  },
  "build": {
    "appId": "com.ksbridal.rentaljewellery",
    "productName": "KS Rental Jewellery",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis"]
    }
  }
}
